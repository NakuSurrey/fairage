# Surrey HPC access — read by tunnel and deploy scripts
# real values go in .env (gitignored), placeholders only here
HPC_USER=your_hpc_username
HPC_LOGIN_NODE=your_hpc_login_hostname

# Weights & Biases — for training run logging
# get key from https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=fairage
WANDB_ENTITY=your_wandb_username

# Hetzner deploy target — used by scp / docker push helpers
HETZNER_HOST=your_hetzner_ip_or_hostname
HETZNER_USER=root

# api runtime config — read by FastAPI app
API_HOST=127.0.0.1
API_PORT=8003

# streamlit demo — read by streamlit app
STREAMLIT_PORT=8503

# model artifact path — relative to repo root
MODEL_CHECKPOINT_PATH=artifacts/exports/age_model.tflite
